<?xml version="1.0" encoding="utf-8"?>
<!-- Firebase looks these up by name at runtime (getIdentifier), which the
     release resource shrinker cannot see. They exist only in builds made with
     the FIREBASE_* dart-defines (see app/build.gradle.kts). -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@string/google_app_id,@string/google_api_key,@string/project_id,@string/gcm_defaultSenderId" />
